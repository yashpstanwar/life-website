# ---------------------------------------------------------------------------
# Razorpay — get these from Razorpay Dashboard → Settings → API Keys
# Leave them BLANK until the account is activated. The site detects that and
# shows bank transfer / UPI details instead of a broken pay button.
# ---------------------------------------------------------------------------

# Publishable key. Safe to expose; it is sent to the browser.
RAZORPAY_KEY_ID=

# SECRET. Server-side only. Never commit this, never put it in any src/ file.
RAZORPAY_KEY_SECRET=

# Webhook signing secret. You choose this string when creating the webhook in
# Razorpay Dashboard → Settings → Webhooks. Must match exactly.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Monthly giving (optional, add later)
# Create a Plan in Razorpay Dashboard → Subscriptions → Plans for each amount,
# then paste the plan id here. Until set, monthly gifts fall back to one-time.
# ---------------------------------------------------------------------------
# RAZORPAY_PLAN_MONTHLY_500=plan_xxxxxxxxxxxx
# RAZORPAY_PLAN_MONTHLY_1000=plan_xxxxxxxxxxxx
# RAZORPAY_PLAN_MONTHLY_2500=plan_xxxxxxxxxxxx
# RAZORPAY_PLAN_MONTHLY_5000=plan_xxxxxxxxxxxx
